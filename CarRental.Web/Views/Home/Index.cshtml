@model CarRental.Web.Models.CarSearchViewModel

@{
    ViewData["Title"] = "Available Cars";
}

<div class="container mt-4">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Available Cars</h2>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <p class="text-muted mb-0">
                    Welcome, @User.Identity.Name
                </p>
            }
        </div>

        <div class="d-flex">
            <a asp-controller="Profile"
               asp-action="Index"
               class="btn btn-outline-primary me-2">
                Profile Settings
            </a>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="btn btn-outline-danger">
                    Logout
                </button>
            </form>
        </div>
    </div>


    <!-- Search Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="mb-3">Search Cars</h4>

            <form asp-controller="Home"
                  asp-action="Index"
                  method="get">

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label asp-for="Location"
                               class="form-label"></label>

                        <input asp-for="Location"
                               class="form-control"
                               placeholder="e.g. Nablus"/>
                    </div>


                    <div class="col-md-3 mb-3">
                        <label asp-for="StartDate"
                               class="form-label">
                            Start Date
                        </label>

                        <input asp-for="StartDate"
                               class="form-control"/>
                    </div>


                    <div class="col-md-3 mb-3">
                        <label asp-for="EndDate"
                               class="form-label">
                            End Date
                        </label>

                        <input asp-for="EndDate"
                               class="form-control"/>

                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>
                    </div>


                    <div class="col-md-3 mb-3">
                        <label asp-for="Make"
                               class="form-label"></label>

                        <input asp-for="Make"
                               class="form-control"
                               placeholder="e.g. Toyota"/>
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Clear
                </a>

            </form>

        </div>
    </div>


    <!-- Search Results -->
    <h3 class="mb-3">Cars</h3>

    @if (Model.Cars.Count == 0)
    {
        <div class="alert alert-info">
            No available cars found.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var car in Model.Cars)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h4 class="card-title">
                                @car.Make @car.Model
                            </h4>

                            <p class="card-text">
                                <strong>Year:</strong>
                                @car.Year
                            </p>

                            <p class="card-text">
                                <strong>Location:</strong>
                                @car.Location
                            </p>

                            <p class="card-text">
                                <strong>Price per day:</strong>
                                $@car.PricePerDay.ToString("0.00")
                            </p>
                            
                            @if (Model.StartDate.HasValue &&
                                 Model.EndDate.HasValue)
                            {
                                <form asp-controller="Reservation"
                                      asp-action="Create"
                                      method="post">

                                    <input type="hidden"
                                           name="CarId"
                                           value="@car.Id" />

                                    <input type="hidden"
                                           name="StartDate"
                                           value="@Model.StartDate.Value.ToString("yyyy-MM-dd")" />

                                    <input type="hidden"
                                           name="EndDate"
                                           value="@Model.EndDate.Value.ToString("yyyy-MM-dd")" />

                                    <button type="submit"
                                            class="btn btn-success">
                                        Book
                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>